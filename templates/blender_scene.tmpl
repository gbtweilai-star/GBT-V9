# ───────────────────────── 材质 ─────────────────────────
def mat(name):
    p = DATA["mat"][name]
    m = bpy.data.materials.new(name); m.use_nodes = True
    nt2 = m.node_tree
    bsdf = nt2.nodes.get("Principled BSDF")
    r, g, b = p["base"]
    bsdf.inputs["Base Color"].default_value = (r, g, b, 1.0)
    bsdf.inputs["Roughness"].default_value = p.get("rough", 0.6)
    if "Metallic" in bsdf.inputs:
        bsdf.inputs["Metallic"].default_value = p.get("metal", 0.0)
    # 皮肤：次表面散射（人皮透出来的那点光，最影响"像不像活人"）
    if p.get("sss"):
        for key, val in (("Subsurface Weight", p["sss"]), ("Subsurface Scale", 0.02),
                         ("Subsurface Radius", (0.36, 0.14, 0.09))):
            if key in bsdf.inputs:
                try:
                    bsdf.inputs[key].default_value = val
                except Exception:
                    pass
    # 布料：绒面（Sheen）让西装不像塑料
    if p.get("sheen") and "Sheen Weight" in bsdf.inputs:
        bsdf.inputs["Sheen Weight"].default_value = p["sheen"]
        if "Sheen Roughness" in bsdf.inputs:
            bsdf.inputs["Sheen Roughness"].default_value = 0.35
    if "Specular IOR Level" in bsdf.inputs:
        bsdf.inputs["Specular IOR Level"].default_value = p.get("spec", 0.5)
    # 布料/皮肤加一点噪声凹凸：表面不是数学光滑，才不像塑料
    if p.get("noise"):
        tex = nt2.nodes.new("ShaderNodeTexNoise"); tex.inputs["Scale"].default_value = p["noise"]
        bump = nt2.nodes.new("ShaderNodeBump")
        bump.inputs["Strength"].default_value = p.get("bump", 0.12)
        nt2.links.new(tex.outputs["Fac"], bump.inputs["Height"])
        nt2.links.new(bump.outputs["Normal"], bsdf.inputs["Normal"])
    m.diffuse_color = (r, g, b, 1.0)
    return m

# ───────────────────────── 几何工具 ─────────────────────────
def _basis(a, b):
    dx, dy, dz = b[0]-a[0], b[1]-a[1], b[2]-a[2]
    ln = math.sqrt(dx*dx + dy*dy + dz*dz) or 1e-6
    d = (dx/ln, dy/ln, dz/ln)
    rx, ry, rz = (0.0, 1.0, 0.0) if abs(d[2]) < 0.9 else (1.0, 0.0, 0.0)
    u = (d[1]*rz - d[2]*ry, d[2]*rx - d[0]*rz, d[0]*ry - d[1]*rx)
    ul = math.sqrt(sum(c*c for c in u)) or 1e-6
    u = tuple(c/ul for c in u)
    v = (d[1]*u[2] - d[2]*u[1], d[2]*u[0] - d[0]*u[2], d[0]*u[1] - d[1]*u[0])
    return d, u, v, ln

def push_path(verts, faces, pts, radii, seg=12, cap=True, wobble=0.0):
    """沿折线放一圈圈（半径可逐点给）→ 肢体 / 发丝 / 手指 / 兔耳都用它。

    wobble>0 时给横截面加正弦起伏（做布褶、发束的蓬松）。
    """
    ring_idx = []
    for i, p in enumerate(pts):
        if i == 0:
            nxt = pts[1]
            _, _, _, _ = None, None, None, None
            t = (nxt[0]-p[0], nxt[1]-p[1], nxt[2]-p[2])
        elif i == len(pts)-1:
            prv = pts[i-1]
            t = (p[0]-prv[0], p[1]-prv[1], p[2]-prv[2])
        else:
            a, b = pts[i-1], pts[i+1]
            t = (b[0]-a[0], b[1]-a[1], b[2]-a[2])
        tl = math.sqrt(sum(c*c for c in t)) or 1e-6
        d = tuple(c/tl for c in t)
        rx, ry, rz = (0.0, 1.0, 0.0) if abs(d[2]) < 0.9 else (1.0, 0.0, 0.0)
        u = (d[1]*rz - d[2]*ry, d[2]*rx - d[0]*rz, d[0]*ry - d[1]*rx)
        ul = math.sqrt(sum(c*c for c in u)) or 1e-6
        u = tuple(c/ul for c in u)
        v = (d[1]*u[2] - d[2]*u[1], d[2]*u[0] - d[0]*u[2], d[0]*u[1] - d[1]*u[0])
        rr = radii[i]
        start = len(verts)
        for k in range(seg):
            th = 2.0*math.pi*k/seg
            mul = 1.0 + wobble*math.sin(th*3.0) if wobble else 1.0
            cu, su = math.cos(th)*rr*mul, math.sin(th)*rr*mul
            verts.append((p[0] + u[0]*cu + v[0]*su,
                          p[1] + u[1]*cu + v[1]*su,
                          p[2] + u[2]*cu + v[2]*su))
        ring_idx.append(start)
    for i in range(len(pts)-1):
        s0, s1 = ring_idx[i], ring_idx[i+1]
        for k in range(seg):
            j = (k+1) % seg
            faces.append((s0+k, s0+j, s1+j, s1+k))
    if cap:
        c0 = len(verts); verts.append(tuple(pts[0]))
        c1 = len(verts); verts.append(tuple(pts[-1]))
        for k in range(seg):
            j = (k+1) % seg
            faces.append((c0, ring_idx[0]+j, ring_idx[0]+k))
            faces.append((c1, ring_idx[-1]+k, ring_idx[-1]+j))
    return ring_idx[0]

def push_seg(verts, faces, a, b, r1, r2=None, seg=12):
    return push_path(verts, faces, [a, b], [r1, r2 if r2 is not None else r1], seg=seg)

def push_ball(verts, faces, c, rx, ry, rz, seg=16, rings=10):
    cx, cy, cz = c
    idx0 = len(verts)
    rows = []
    for r in range(1, rings):
        phi = math.pi * r / rings
        sp, cp = math.sin(phi), math.cos(phi)
        row = []
        for k in range(seg):
            th = 2.0*math.pi*k/seg
            row.append(len(verts))
            verts.append((cx + rx*sp*math.cos(th), cy + ry*sp*math.sin(th), cz + rz*cp))
        rows.append(row)
    top = len(verts); verts.append((cx, cy, cz + rz))
    bot = len(verts); verts.append((cx, cy, cz - rz))
    for r in range(len(rows)-1):
        for k in range(seg):
            j = (k+1) % seg
            faces.append((rows[r][k], rows[r][j], rows[r+1][j], rows[r+1][k]))
    for k in range(seg):
        j = (k+1) % seg
        faces.append((top, rows[0][k], rows[0][j]))
        faces.append((bot, rows[-1][j], rows[-1][k]))
    return idx0

def push_box(verts, faces, a, b, w, t):
    """扁平件（翻领 / 领带 / 指甲 / 鞋底）：沿 a→b 的扁长方体。"""
    d, u, v, ln = _basis(a, b)
    idx0 = len(verts)
    for s in (0.0, 1.0):
        cx, cy, cz = a[0]+d[0]*ln*s, a[1]+d[1]*ln*s, a[2]+d[2]*ln*s
        for su, sv in ((-1, -1), (1, -1), (1, 1), (-1, 1)):
            verts.append((cx + u[0]*w/2*su + v[0]*t/2*sv,
                          cy + u[1]*w/2*su + v[1]*t/2*sv,
                          cz + u[2]*w/2*su + v[2]*t/2*sv))
    for k in range(4):
        j = (k+1) % 4
        faces.append((idx0+k, idx0+j, idx0+4+j, idx0+4+k))
    faces.append((idx0, idx0+1, idx0+2, idx0+3))
    faces.append((idx0+4, idx0+7, idx0+6, idx0+5))
    return idx0

