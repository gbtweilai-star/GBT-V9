        part("hair", "head", push_path, pts, [0.075*hs, 0.070*hs, 0.026*hs], 10)
        pts2 = [(hx + side*0.10*hs, -0.02, hz + 0.25*hs),
                (hx + side*0.17*hs, 0.015, hz + 0.64*hs),
                (hx + side*0.19*hs, -0.005, hz + 1.02*hs)]
        part("inner", "head", push_path, pts2, [0.040*hs, 0.036*hs, 0.014*hs], 8)
# 关节球：把断开的胶囊接起来（肩/肘/腕/膝/踝/髋），否则四肢像浮在空中
for s2 in ("L", "R"):
    for jn, r in ((f"arm{s2}", 0.105), (f"hand{s2}", 0.055),
                  (f"thigh{s2}", 0.125), (f"foot{s2}", 0.050)):
        if jn in B:
            jp = J(jn)
            grp = "suit" if jn.startswith(("arm", "fore")) else "skin"
            part(grp, jn, push_ball, jp, r, r, r)
if "hip" in B:
    hip = J("hip")
    part("hair", "hip", push_ball, (hip[0]-0.40, 0.20, hip[2]+0.06), 0.135, 0.130, 0.135)
    for k2 in range(5):
        th2 = 2.0*math.pi*k2/5.0
        part("hair", "hip", push_ball,
             (hip[0]-0.40 + math.cos(th2)*0.10, 0.20 + math.sin(th2)*0.10, hip[2]+0.06),
             0.070, 0.070, 0.070)

OBJS = []
for group, items in PARTS.items():
    verts, faces, vg = [], [], []
    for bone, fn, args, kw in items:
        idx = fn(verts, faces, *args, **kw)
        vg.append((bone, list(range(idx, len(verts)))))
    me = bpy.data.meshes.new(group + "_mesh")
    me.from_pydata(verts, [], faces); me.update()
    ob = bpy.data.objects.new(group, me)
    scene.collection.objects.link(ob)
    ob.data.materials.append(mat(group))
    for bone, idxs in vg:
        g = ob.vertex_groups.new(name=bone)
        g.add(idxs, 1.0, "REPLACE")
    bpy.context.view_layer.objects.active = ob
    ob.select_set(True)
    bpy.ops.object.mode_set(mode="EDIT")
    bpy.ops.mesh.select_all(action="SELECT")
    bpy.ops.object.vertex_group_smooth(group_select_mode="ALL", factor=0.55, repeat=3)
    bpy.ops.object.mode_set(mode="OBJECT")
    bpy.ops.object.shade_smooth()
    md = ob.modifiers.new("Armature", "ARMATURE"); md.object = arm_obj
    sub = ob.modifiers.new("Subdivision", "SUBSURF")
    sub.levels = 1; sub.render_levels = 2
    ob.parent = arm_obj
    ob.select_set(False)
    OBJS.append(ob)

# ───────────────────────── 灯光（影棚三点光 + 地面接影） ─────────────────────────
def light(kind, loc, energy, size, rot, color=(1.0, 1.0, 1.0)):
    ld = bpy.data.lights.new("L_" + kind, type=kind)
    ld.energy = energy
    if kind == "AREA":
        ld.size = size
    ld.color = color
    lo = bpy.data.objects.new("L_" + kind, ld)
    lo.location = loc
    lo.rotation_euler = rot
    scene.collection.objects.link(lo)
    return lo

sc = HEIGHT / 5.2                                        # 相对尺度
light("AREA", (1.6*sc, -2.4*sc, 1.5*sc), 150*sc*sc, 2.2*sc,
      (math.radians(58), 0, math.radians(28)), (1.0, 0.97, 0.93))     # 主光（暖）
light("AREA", (-2.2*sc, -1.6*sc, 0.7*sc), 48*sc*sc, 3.0*sc,
      (math.radians(78), 0, math.radians(-42)), (0.92, 0.95, 1.0))    # 补光（冷）
light("AREA", (0.4*sc, 2.6*sc, 1.9*sc), 160*sc*sc, 1.8*sc,
      (math.radians(118), 0, math.radians(8)), (1.0, 0.99, 1.0))      # 轮廓光
# 地面：让影子落下来，人才"站得住"
bpy.ops.mesh.primitive_plane_add(size=24*sc, location=(xmid, 0.0, zmin - 0.03))
floor = bpy.context.active_object
fm = mat("floor")
floor.data.materials.append(fm)
floor.name = "floor"

# ───────────────────────── 动作 K 帧（世界 Y 旋转 → 父骨空间四元数） ─────────────────────────
bpy.context.view_layer.objects.active = arm_obj
bpy.ops.object.mode_set(mode="POSE")
for pb in arm_obj.pose.bones:
    pb.rotation_mode = "QUATERNION"
frames = DATA["frames"]
for i, rots in enumerate(frames):
    fr = i + 1
    for name, delta in rots.items():
        pb = arm_obj.pose.bones.get(name)
        if not pb or abs(delta) < 1e-9:
            continue
        bone = arm_obj.data.bones[name]
        rest = bone.matrix_local.to_3x3()
        M = rest if not bone.parent else (bone.parent.matrix_local.to_3x3().inverted() @ rest)
        R = Quaternion((0.0, 1.0, 0.0), math.radians(-float(delta))).to_matrix()
        pb.rotation_quaternion = (M.inverted() @ R @ M).to_quaternion()
        pb.keyframe_insert(data_path="rotation_quaternion", frame=fr)
if arm_obj.animation_data and arm_obj.animation_data.action:
    for fc in arm_obj.animation_data.action.fcurves:
        for kp in fc.keyframe_points:
            kp.interpolation = "LINEAR"
bpy.ops.object.mode_set(mode="OBJECT")
scene.frame_start, scene.frame_end = 1, len(frames)

# ───────────────────────── 相机（透视 3/4 + 景深） ─────────────────────────
cam_data = bpy.data.cameras.new("cam")
cam_data.lens = 62.0
cam_data.sensor_fit = "VERTICAL"
cam_data.sensor_height = 24.0
cam_data.dof.use_dof = True
cam_data.dof.focus_object = arm_obj
cam_data.dof.aperture_fstop = 2.6
cam = bpy.data.objects.new("cam", cam_data)
scene.collection.objects.link(cam); scene.camera = cam
AZ, EL = math.radians(20.0), math.radians(5.0)
DIST = HEIGHT * 1.30 * cam_data.lens / cam_data.sensor_height
def place_cam(az, el, dist):
    cam.location = (xmid + math.sin(az)*dist*math.cos(el),
                    -math.cos(az)*dist*math.cos(el),
                    zc + math.sin(el)*dist)
    cam.rotation_euler = (math.radians(90) - el, 0.0, az)

# ───────────────────────── 输出 ─────────────────────────
if MODE == "preview":
    nf = len(frames); mid = max(1, nf // 2)
    scene.frame_set(mid)
    for i in range(ANGLES):
        place_cam(2.0*math.pi*i/ANGLES, EL, DIST)
        scene.render.filepath = r"__OUT_DIR__" + "/" + DATA["clip"] + "_a%02d.png" % i
        bpy.ops.render.render(write_still=True)
    for i in range(STRIPS):
        f = 1 + int(round(i * (nf - 1) / max(1, STRIPS - 1)))
        scene.frame_set(f)
        place_cam(AZ, EL, DIST)
        scene.render.filepath = r"__OUT_DIR__" + "/" + DATA["clip"] + "_f%02d.png" % i
        bpy.ops.render.render(write_still=True)
    print("V9_BLENDER_OK", "preview", DATA["clip"])
else:
    scene.frame_set(1 + len(frames) // 3)
    place_cam(AZ, EL, DIST)
    scene.render.filepath = OUT_PNG
    bpy.ops.render.render(write_still=True)
    bpy.ops.export_scene.gltf(filepath=OUT_GLB, export_format="GLB",
                              export_animations=True, export_frame_range=True)
    print("V9_BLENDER_OK", OUT_PNG, OUT_GLB)
