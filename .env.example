# ═══ GBT小土豆V9 · 环境变量模板（复制为 .env 后填写；不要提交真实密钥）═══

# ── 主脑 LLM 网关（CLIProxyAPI，OpenAI 兼容）──
OPENAI_API_KEY=your-brain-client-key
OPENAI_BASE_URL=http://127.0.0.1:8317/v1
CLI_PROXY_MGMT_KEY=your-gateway-management-key

# ── 本机 Qwen（可选，推荐；真·无配额大脑）──
OLLAMA_HOST=http://127.0.0.1:11434

# ── R2 对象存储（吞噬能温层）──
#  真 R2：填下面 4 项；离线演练：只填 R2_SIM_DIR（本地目录模拟 S3）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tentacle-archive
# R2_SIM_DIR=state/r2-sim

# ── 吞噬能 ──
DEVOUR_DIR=devoured/t1-eye
DEVOUR_FPS=30
LEDGER_DB=tentacle_ledger.db

# ── 分层存储水位 ──
STORE_HIGH=0.85
STORE_LOW=0.60
SEG_FRAMES=1800
KEEP_LAST_SEGMENTS=2

# ── 缓存回收（面板 _preview / _cache 双预算）──
PREVIEW_CACHE_MB=2048
PULL_CACHE_MB=5120
REAP_INTERVAL_SEC=120

# ── 槽位板 ──
SLOT_CLAIM_TIMEOUT_S=90

# ── 面板 / V9 ──
PANEL_PORT=8765
GBT_V9_HOME=C:/Users/ADMIN/gbt-potato-v9
