# ══════════════════════════════════════════════════════════
# 身体登记链 · 外部见证（第二见证：独立账户 × 独立供应商）
#   —— 凭据只从环境变量读；本文件不得出现任何可用凭据字面量
# ══════════════════════════════════════════════════════════
# 见证注册表
BODY_WITNESSES=r2-primary,archive-b,ts-ots,offline-usb
BODY_WITNESS_REQUIRED_EXTERNAL=2          # 安全底线：≥2 个【独立凭据域】才算 healthy
BODY_WITNESS_MIN_EVIDENCE=E3              # E3=provider 权威账户证明；E2=弱证据（attested）
BODY_WITNESS_FP_KEY=                      # 凭据域指纹 HMAC key（部署密钥库注入，绝不入库）
BODY_WITNESS_KEYRING=/etc/gbt/witness/keyring.json
BODY_CHAIN_FAIL_MODE=warn                 # warn | freeze | halt（链断时的处置）
BODY_WITNESS_FAIL_MODE=freeze             # 身份不可信时的处置
BODY_ANCHOR_EPOCH=e1
BODY_ANCHOR_KID=anchor/1
BODY_RECHECK_PERIOD=21600                 # 定期全链复核间隔（秒）
BODY_WITNESS_PROBE_INTERVAL=30
BODY_WITNESS_PROBE_TTL=60
BODY_DB=sqlite:///var/body.db             # 身体库（链 + 见证状态）

# ── witness #1：r2-primary（外部域 #1，即时锚点）──
BODY_WITNESS_R2_PRIMARY_KIND=s3
BODY_WITNESS_R2_PRIMARY_PROVIDER=cloudflare-r2
BODY_WITNESS_R2_PRIMARY_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BODY_WITNESS_R2_PRIMARY_REGION=auto
BODY_WITNESS_R2_PRIMARY_BUCKET=body-anchors
BODY_WITNESS_R2_PRIMARY_ACCESS_KEY_ID=
BODY_WITNESS_R2_PRIMARY_SECRET_ACCESS_KEY=
BODY_WITNESS_R2_PRIMARY_KID=r2-primary/2026-10/1
# 升级到 E3（权威账户证明）需要：CLOUDFLARE_API_TOKEN=（只读账户列表权限）

# ── witness #2：archive-b（★独立账户 × 独立供应商 ← 第二见证）──
BODY_WITNESS_ARCHIVE_B_KIND=s3
BODY_WITNESS_ARCHIVE_B_PROVIDER=backblaze-b2   # 供应商名必须与 #1 不同
BODY_WITNESS_ARCHIVE_B_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BODY_WITNESS_ARCHIVE_B_REGION=us-west-004
BODY_WITNESS_ARCHIVE_B_BUCKET=gbt-body-witness  # 建桶时开启 Object Lock（不可覆盖）
BODY_WITNESS_ARCHIVE_B_ACCESS_KEY_ID=
BODY_WITNESS_ARCHIVE_B_SECRET_ACCESS_KEY=
BODY_WITNESS_ARCHIVE_B_KID=archive-b/2026-10/1
BODY_WITNESS_ARCHIVE_B_IMMUTABLE=1
BODY_WITNESS_ARCHIVE_B_RETAIN_DAYS=3650
# A 方案（它是存储凭据）：上面已就位。
# B 方案（它是签名密钥）：写进 /etc/gbt/witness/archive-b.ed25519（0600），
#   ACCESS_KEY_ID/SECRET 另配一套**另一个账户**的凭据 —— 两套不能同账户。

# ── witness #3：ts-ots（无账号，补充证据；pending 不计票）──
BODY_WITNESS_TS_OTS_KIND=ots
BODY_WITNESS_TS_OTS_PROOF_DIR=/var/lib/gbt/ots

# ── witness #4：offline-usb（本地副本，永不计票）──
BODY_WITNESS_OFFLINE_USB_KIND=dir
BODY_WITNESS_OFFLINE_USB_PATH=/mnt/usb/gbt-anchors
